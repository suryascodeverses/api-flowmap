{
  "name": "api-graph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @api-graph/core build",
    "build:cli": "pnpm --filter @api-graph/cli build",
    "build:server": "pnpm --filter @api-graph/server build",
    "build:ui": "pnpm --filter @api-graph/ui build",
    "dev:server": "pnpm --filter @api-graph/server dev",
    "dev:ui": "pnpm --filter @api-graph/ui dev",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^5.3.0"
  }
}
